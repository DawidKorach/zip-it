{
	"name": "@da-core/zip-it",
	"version": "1.1.0",
	"description": "Create lightweight project ZIP archives with minimized media placeholders.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"zip-it": "bin/zip-it.cjs",
		"zip-it-dotnet-init": "bin/zip-it-dotnet-init.cjs"
	},
	"files": [
		"bin",
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"local": "npm run build && node dist/cli.js",
		"prepublishOnly": "npm run clean && npm run build",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test tests/*.test.mjs"
	},
	"dependencies": {
		"fast-glob": "^3.3.3",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@types/yazl": "^3.3.1",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js"
		},
		"./dotnet-init": {
			"types": "./dist/dotnet-init-cli.d.ts",
			"import": "./dist/dotnet-init-cli.js"
		}
	}
}
